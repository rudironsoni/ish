# Linux test environment for iSH aarch64
# BUILDS and TESTS entirely within the container (CI/CD ready)

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install all build and test dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    git \
    wget \
    tar \
    xz-utils \
    qemu-user-static \
    qemu-system-arm \
    gcc-aarch64-linux-gnu \
    g++-aarch64-linux-gnu \
    libc6-dev-arm64-cross \
    binutils-aarch64-linux-gnu \
    valgrind \
    clang-tidy \
    && rm -rf /var/lib/apt/lists/*

# Install musl cross compiler for static binaries
RUN cd /tmp && \
    wget https://musl.cc/aarch64-linux-musl-cross.tgz && \
    tar xzf aarch64-linux-musl-cross.tgz -C /opt && \
    rm aarch64-linux-musl-cross.tgz

ENV PATH="/opt/aarch64-linux-musl-cross/bin:$PATH"

# Enable QEMU binfmt for transparent emulation
RUN update-binfmts --enable qemu-aarch64 || true

# Create working directory
WORKDIR /ish

# Copy source code (in CI, this is the repo; locally, it's the working directory)
# Using COPY . . would copy everything - for CI we want selective copy
COPY meson.build meson_options.txt ./
COPY emu/ ./emu/
COPY kernel/ ./kernel/
COPY tests/aarch64/ ./tests/aarch64/
COPY misc.h debug.h ./

# Create build and results directories
RUN mkdir -p build tests/aarch64/results

# BUILD STAGE: Compile all test binaries
RUN echo "========================================" && \
    echo "Building Test Binaries" && \
    echo "========================================" && \
    gcc -I. -Iemu -Ikernel \
        tests/aarch64/decoder_test.c emu/aarch64/decode.c \
        -o build/decoder_test && \
    gcc -I. -Iemu -Ikernel \
        tests/aarch64/test-dp-reg.c emu/aarch64/decode.c \
        -o build/test-dp-reg && \
    echo "Build complete!"

# TEST STAGE: Run all tests
# This is the default command when container runs
COPY <<'EOF' /ish/run-tests.sh
#!/bin/bash
set -e

echo '========================================'
echo 'iSH aarch64 Linux Test Suite'
echo '========================================'
echo ''

echo '1. ARM Reference Validation'
echo '---------------------------'
bash tests/aarch64/tools/reference-check.sh 2>&1 | tee tests/aarch64/results/arm-reference.log
REF_STATUS=${PIPESTATUS[0]}
echo ''

echo '2. Decoder Unit Tests'
echo '---------------------'
./build/decoder_test 2>&1 | tee tests/aarch64/results/decoder_test.log || true
DECODER_STATUS=${PIPESTATUS[0]}
echo ''

echo '3. DP Register Tests'
echo '--------------------'
./build/test-dp-reg 2>&1 | tee tests/aarch64/results/test-dp-reg.log || true
DPREG_STATUS=${PIPESTATUS[0]}
echo ''

echo '========================================'
echo 'Test Summary'
echo '========================================'
echo "ARM Reference: $([ $REF_STATUS -eq 0 ] && echo 'PASS' || echo 'FAIL')"
echo "Decoder Tests: $([ $DECODER_STATUS -eq 0 ] && echo 'PASS' || echo 'FAIL')"
echo "DP Reg Tests: $([ $DPREG_STATUS -eq 0 ] && echo 'PASS' || echo 'FAIL')"
echo ''
echo 'Results saved to: tests/aarch64/results/'

# Exit with error if any test failed
if [ $REF_STATUS -ne 0 ] || [ $DECODER_STATUS -ne 0 ] || [ $DPREG_STATUS -ne 0 ]; then
    exit 1
fi
EOF

RUN chmod +x /ish/run-tests.sh

CMD ["/ish/run-tests.sh"]
