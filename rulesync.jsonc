{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": [
    "copilot",
    "copilotcli",
    "claudecode",
    "codexcli",
    "opencode",
    "antigravity",
    "factorydroid",
    "geminicli",
    "zed",
    "agentsmd"    
  ],
  "features": [
    "rules",
    "ignore",
    "mcp",
    "commands",
    "subagents",
    "skills",
    "hooks"
  ],
  "baseDirs": [
    "."
  ],
  "sources": [
    { "source": "dyoshikawa/rulesync" },
    { "source": "anthropics/skills", "skills": ["skill-creator"] }
  ],
  "delete": true,
  "verbose": true,
  "silent": false,
  "global": false,
  "simulateCommands": false,
  "simulateSubagents": false,
  "simulateSkills": false
}
