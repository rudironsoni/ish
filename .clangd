# clangd configuration for ish
# compile_commands.json (from Xcode build) is the primary flag source.
# This file provides fallback flags for files not in compile_commands.json
# and diagnostic policy.
#
# Regenerate compile_commands.json:
#   xcodebuild clean build -project IXLand.xcodeproj \
#     -scheme IXLandRuntime-6.12-arm64 \
#     -destination 'platform=iOS Simulator,name=iPhone 17' \
#     -derivedDataPath /Volumes/1TB/Xcode/DerivedData \
#     COMPILER_INDEX_STORE_ENABLE=NO
#   Then: python3 tools/gen_compile_commands.py

CompileFlags:
  Add:
    - -Ithird_party/linux-uapi/6.12/arm64/include
    - -Iinclude
    - -ISources
    - -I.
    - -IPackages/IXLandInstrumentation/Sources/IXLandInstrumentation/include
    - -IPackages/IXLandInstrumentation/Sources/IXLandInstrumentationTracing/include
  Remove:
    - -index-store-path
    - -index-unit-output-path

Diagnostics:
  Suppress:
    - pp_file_not_found
  ClangTidy:
    FastCheckFilter: Strict
