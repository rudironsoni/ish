{
  "$schema": "https://opencode.ai/config.json",
  "theme": "synthwave84",
  "permission": {
    "edit": {
      "*": "allow",
      "third_party/linux-uapi/**": "deny"
    },
    "read": {
      "*": "allow"
    }
  },
  "formatter": {
    "clang-format-objc": {
      "command": [
        "clang-format",
        "-i",
        "$FILE"
      ],
      "extensions": [
        ".m",
        ".mm"
      ]
    }
  },
  "lsp": {
    "asm-lsp": {
      "command": [
        "asm-lsp"
      ],
      "extensions": [
        ".s",
        ".S",
        ".asm"
      ],
      "initialization": {
        "assembler": "gas",
        "instruction_set": "arm64"
      }
    },
    "clangd": {
      "command": [
        "/usr/bin/clangd"
      ],
      "extensions": [
        ".c",
        ".cpp",
        ".cc",
        ".cxx",
        ".m",
        ".mm",
        ".h",
        ".hpp",
	".hxx"
      ]
    },
    "sourcekit-lsp": {
      "disabled": true
    }
  }
}
