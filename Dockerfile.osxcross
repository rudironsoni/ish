# osxcross build environment for cross-compiling to macOS/iOS from Linux
# Provides frugal CI/CD without requiring macOS runners

FROM ubuntu:22.04

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && apt-get install -y \
    clang \
    llvm \
    lld \
    cmake \
    ninja-build \
    libssl-dev \
    libxml2-dev \
    libz-dev \
    libbz2-dev \
    libedit-dev \
    libsqlite3-dev \
    git \
    wget \
    curl \
    python3 \
    python3-pip \
    xz-utils \
    bzip2 \
    patch \
    libmpc-dev \
    libmpfr-dev \
    libgmp-dev \
    && rm -rf /var/lib/apt/lists/*

# Install osxcross
RUN git clone https://github.com/tpoechtrager/osxcross.git /opt/osxcross
WORKDIR /opt/osxcross

# Note: macOS SDK must be provided at build time
# Place MacOSX14.0.sdk.tar.xz in the build context
# SDK can be extracted from Xcode using tools/gen_sdk_package.sh on macOS
COPY MacOSX*.sdk.tar.xz /opt/osxcross/tarballs/ 2>/dev/null || true

# If SDK is not provided, create a minimal placeholder for build
RUN if [ ! -f /opt/osxcross/tarballs/MacOSX*.sdk.tar.xz ]; then \
    echo "WARNING: No macOS SDK found. Cross-compilation disabled."; \
    echo "To enable: Extract SDK from Xcode and place in tarballs/"; \
    fi

# Build osxcross if SDK is available
RUN if [ -f /opt/osxcross/tarballs/MacOSX*.sdk.tar.xz ]; then \
    UNATTENDED=1 OSX_VERSION_MIN=14.0 ./build.sh && \
    ./build_compiler_rt.sh; \
    fi

# Set up environment
ENV PATH="/opt/osxcross/target/bin:$PATH"
ENV CC="o64-clang"
ENV CXX="o64-clang++"
ENV AR="x86_64-apple-darwin23-ar"
ENV LD="x86_64-apple-darwin23-ld"

# Create working directory
WORKDIR /ish

# Default command shows available targets
CMD ["bash", "-c", "echo 'osxcross environment ready' && ls -la /opt/osxcross/target/bin/ | head -20"]
