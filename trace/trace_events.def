/*
 * trace_events.def
 * Event definition file for the iSH tracing subsystem.
 * 
 * Format: TRACE_EVENT(name, level, category, payload_size)
 * 
 * This file defines the core event taxonomy. It can be processed by
 * code generators or included directly for compile-time constants.
 */

#ifndef TRACE_EVENT
#define TRACE_EVENT(name, level, category, payload_size)
#endif

/* ============================================
 * Compile and Decode Events
 * ============================================ */

/* Block compilation began - payload: uint64_t end_pc */
TRACE_EVENT(BLOCK_COMPILE_START, 1, TRACE_CAT_COMPILE, 8)

/* Block compilation completed - payload: struct { uint64_t end_pc; uint32_t insn_count; } */
TRACE_EVENT(BLOCK_COMPILE_END, 1, TRACE_CAT_COMPILE, 16)

/* Instruction decode failed - payload: uint32_t raw_insn */
TRACE_EVENT(DECODE_FAILURE, 1, TRACE_CAT_DECODE, 4)

/* Unsupported instruction encountered - payload: uint32_t raw_insn */
TRACE_EVENT(UNSUPPORTED_INSTRUCTION, 1, TRACE_CAT_DECODE, 4)

/* ============================================
 * Runtime Boundary Events
 * ============================================ */

/* Block execution started - payload: uint32_t gadget_count */
TRACE_EVENT(BLOCK_ENTRY, 2, TRACE_CAT_BLOCK, 8)

/* Block execution ended - payload: struct { int exit_reason; uint64_t next_pc; } */
TRACE_EVENT(BLOCK_EXIT, 2, TRACE_CAT_BLOCK, 16)

/* Block found in cache - payload: int cache_level */
TRACE_EVENT(BLOCK_CACHE_HIT, 2, TRACE_CAT_BLOCK, 4)

/* Block not in cache (miss) - no payload */
TRACE_EVENT(BLOCK_CACHE_MISS, 2, TRACE_CAT_BLOCK, 0)

/* Memory fault or exception - payload: struct { uint64_t fault_addr; int is_write; int reason; } */
TRACE_EVENT(FAULT, 2, TRACE_CAT_FAULT, 24)

/* System call entered - payload: struct { uint64_t num; uint64_t x0; uint64_t x1; uint64_t x2; } */
TRACE_EVENT(SYSCALL_ENTER, 2, TRACE_CAT_SYSCALL, 32)

/* System call returned - payload: uint64_t retval */
TRACE_EVENT(SYSCALL_RETURN, 2, TRACE_CAT_SYSCALL, 8)

/* Process execution started - payload: struct { uint64_t sp; uint64_t at_entry; uint64_t at_base; } */
TRACE_EVENT(PROCESS_ENTRY, 1, TRACE_CAT_BLOCK, 32)

/* ============================================
 * Block Detail Events (Level 3+)
 * ============================================ */

/* Register snapshot - payload: uint64_t regs[6] */
TRACE_EVENT(REGISTER_SNAPSHOT, 3, TRACE_CAT_REGISTER, 48)

/* PSTATE snapshot - payload: struct { uint64_t pstate; uint64_t nzcv; } */
TRACE_EVENT(PSTATE_SNAPSHOT, 3, TRACE_CAT_REGISTER, 16)

/* ============================================
 * Emulation Limitation Events (SUMMARY level)
 * ============================================ */

/* Unhandled MRS system register read - payload: uint32_t sysreg (op1|CRn|CRm|op2 encoded) */
TRACE_EVENT(UNHANDLED_MRS, 1, TRACE_CAT_DECODE, 4)

/* Unhandled MSR system register write - payload: uint32_t sysreg (op1|CRn|CRm|op2 encoded) */
TRACE_EVENT(UNHANDLED_MSR, 1, TRACE_CAT_DECODE, 4)

/* ============================================
 * Runtime Error Events (BOUNDARY level)
 * ============================================ */

/* Unknown COMPLEX exit - payload: struct { uint16_t cat; uint16_t subtype; } */
TRACE_EVENT(COMPLEX_UNKNOWN, 2, TRACE_CAT_FAULT, 4)

/* Failed to decode instruction - payload: uint32_t raw_insn */
TRACE_EVENT(COMPLEX_DECODE_FAIL, 2, TRACE_CAT_DECODE, 4)

/* Failed to fetch instruction - payload: uint32_t fault_reason */
TRACE_EVENT(COMPLEX_FETCH_FAIL, 2, TRACE_CAT_FAULT, 4)

/* ============================================
 * NULL current Crash Diagnostics (NEW)
 * ============================================ */

/* Task thread before set - payload: struct { uint64_t task_ptr; uint64_t current_before; } */
TRACE_EVENT(TASK_THREAD_BEFORE_SET, 1, TRACE_CAT_SYSCALL, 16)

/* Task thread after set - payload: struct { uint64_t task_ptr; uint64_t current_after; } */
TRACE_EVENT(TASK_THREAD_AFTER_SET, 1, TRACE_CAT_SYSCALL, 16)

/* Task run_current entry check - payload: uint64_t current_ptr */
TRACE_EVENT(TASK_RUN_CURRENT_ENTRY_CHECK, 1, TRACE_CAT_SYSCALL, 8)

/* ============================================
 * Task Lifecycle Events
 * ============================================ */

/* Task created - payload: struct { uint32_t pid; uint32_t parent_pid; } */
TRACE_EVENT(TASK_CREATE, 1, TRACE_CAT_SYSCALL, 8)

/* Task started execution - payload: uint32_t pid */
TRACE_EVENT(TASK_START, 1, TRACE_CAT_SYSCALL, 4)

/* ============================================
 * App-layer Task Lifecycle Events
 * ============================================ */

/* App entered task runloop to keep alive - no payload */
TRACE_EVENT(APP_TASK_START_RUNLOOP, 1, TRACE_CAT_SYSCALL, 0)

/* ============================================
 * Task Thread Diagnostics (for crash debugging)
 * ============================================ */

/* Task thread entry - payload: uint64_t task_ptr */
TRACE_EVENT(TASK_THREAD_ENTRY, 1, TRACE_CAT_SYSCALL, 8)

/* Task thread current set - payload: struct { uint32_t pid; uint64_t mm; uint64_t mem; } */
TRACE_EVENT(TASK_THREAD_CURRENT_SET, 1, TRACE_CAT_SYSCALL, 24)

/* Task run_current entry - payload: struct { uint64_t current_ptr; uint32_t pid; } */
TRACE_EVENT(TASK_RUN_CURRENT_ENTRY, 1, TRACE_CAT_SYSCALL, 16)

/* Task run_current mem check - payload: struct { uint64_t mm; uint64_t mem; } */
TRACE_EVENT(TASK_RUN_CURRENT_MEM_CHECK, 1, TRACE_CAT_SYSCALL, 16)

/* ============================================
 * Additional Task Diagnostics
 * ============================================ */

/* Task create return - payload: struct { uint32_t pid; uint64_t task_ptr; } */
TRACE_EVENT(TASK_CREATE_RETURN, 1, TRACE_CAT_SYSCALL, 16)

/* Construct task done - payload: struct { uint32_t pid; uint64_t task_ptr; uint64_t mm; uint64_t mem; } */
TRACE_EVENT(CONSTRUCT_TASK_DONE, 1, TRACE_CAT_SYSCALL, 32)

/* Task start pointer - payload: uint64_t task_ptr */
TRACE_EVENT(TASK_START_POINTER, 1, TRACE_CAT_SYSCALL, 8)

/* ============================================
 * MM Lifecycle Events (for crash debugging)
 * ============================================ */

/* mm_new called - payload: uint64_t mm_ptr */
TRACE_EVENT(MM_NEW, 1, TRACE_CAT_MEMORY, 8)

/* mm_copy called - payload: struct { uint64_t src_mm; uint64_t new_mm; } */
TRACE_EVENT(MM_COPY, 1, TRACE_CAT_MEMORY, 16)

/* mm_retain called - payload: struct { uint64_t mm_ptr; uint32_t new_refcount; } */
TRACE_EVENT(MM_RETAIN, 1, TRACE_CAT_MEMORY, 16)

/* mm_release called - payload: struct { uint64_t mm_ptr; uint32_t old_refcount; } */
TRACE_EVENT(MM_RELEASE, 1, TRACE_CAT_MEMORY, 16)

/* mm_release freed mm - payload: uint64_t mm_ptr */
TRACE_EVENT(MM_RELEASE_FREED, 1, TRACE_CAT_MEMORY, 8)

/* task_set_mm called - payload: struct { uint64_t task_ptr; uint64_t new_mm; } */
TRACE_EVENT(TASK_SET_MM, 1, TRACE_CAT_MEMORY, 16)

/* ============================================
 * Task Handoff Proof Events (for crash debugging)
 * ============================================ */

/* Parent: immediately before pthread_create - payload: struct { uint64_t task_ptr; uint64_t mm; uint64_t mem; uint32_t pid; uint64_t host_thread_id; } */
TRACE_EVENT(TASK_HANDOFF_PARENT_PRE_CREATE, 1, TRACE_CAT_SYSCALL, 40)

/* Child: thread entry, before setting current - payload: struct { uint64_t task_arg_ptr; uint64_t task_arg_mm; uint64_t task_arg_mem; uint32_t task_arg_pid; uint64_t host_thread_id; } */
TRACE_EVENT(TASK_HANDOFF_CHILD_ENTRY, 1, TRACE_CAT_SYSCALL, 40)

/* Child: after setting current, before task_run_current - payload: struct { uint64_t current_ptr; uint64_t current_mm; uint64_t current_mem; uint32_t current_pid; uint64_t host_thread_id; } */
TRACE_EVENT(TASK_HANDOFF_CHILD_POST_CURRENT, 1, TRACE_CAT_SYSCALL, 40)

/* Child: entering task_run_current - payload: struct { uint64_t current_ptr; uint64_t current_mm; uint64_t current_mem; uint32_t current_pid; uint64_t host_thread_id; } */
TRACE_EVENT(TASK_HANDOFF_CHILD_PRE_RUN, 1, TRACE_CAT_SYSCALL, 40)

/* ============================================
 * Task Initialization Proof Events (parent-side)
 * ============================================ */

/* Parent: after task->pid is written - payload: struct { uint64_t task_ptr; uint32_t pid; uint64_t host_thread_id; } */
TRACE_EVENT(TASK_INIT_AFTER_PID_WRITE, 1, TRACE_CAT_SYSCALL, 16)

/* Parent: after task->mm is written - payload: struct { uint64_t task_ptr; uint64_t mm; uint64_t host_thread_id; } */
TRACE_EVENT(TASK_INIT_AFTER_MM_WRITE, 1, TRACE_CAT_SYSCALL, 24)

/* Parent: after task->mem is written - payload: struct { uint64_t task_ptr; uint64_t mem; uint64_t host_thread_id; } */
TRACE_EVENT(TASK_INIT_AFTER_MEM_WRITE, 1, TRACE_CAT_SYSCALL, 24)

/* Parent: pre-pthread_create with full state - payload: struct { uint64_t task_ptr; uint64_t mm; uint64_t mem; uint32_t pid; uint64_t host_thread_id; } */
TRACE_EVENT(TASK_INIT_PRE_PTHREAD_CREATE, 1, TRACE_CAT_SYSCALL, 40)

/* ============================================
 * Task Field Write Tracking (detect clobber/reset)
 * ============================================ */

/* Any write to task->pid/mm/mem - payload: struct { 
 *   uint64_t task_ptr; 
 *   uint8_t field_id;  // 0=pid, 1=mm, 2=mem
 *   uint8_t site_id;   // code site identifier
 *   uint32_t pid_val;  // for pid field
 *   uint64_t ptr_val;  // for mm/mem field
 *   uint64_t host_thread_id;
 * } */
TRACE_EVENT(TASK_FIELD_WRITE, 1, TRACE_CAT_SYSCALL, 32)

/* Task checkpoint trace for finding zero transition - payload: struct {
 *   uint64_t task_ptr;
 *   uint32_t checkpoint_id;  // 1-8 as specified
 *   uint32_t pid;
 *   uint64_t mm;
 *   uint64_t mem;
 *   uint64_t host_thread_id;
 * } */
TRACE_EVENT(TASK_CHECKPOINT, 1, TRACE_CAT_SYSCALL, 32)

/* ============================================
 * Memory Snapshot and Bulk Write Detection
 * ============================================ */

/* Raw memory snapshot of task struct - payload: struct {
 *   uint64_t task_ptr;
 *   uint64_t snapshot_id;  // 0=parent_pre_create, 1=child_entry, 2=child_post_current
 *   uint64_t canary_value; // expected magic value
 *   uint64_t host_thread_id;
 *   uint32_t pid_field;
 *   uint64_t mm_field;
 *   uint64_t mem_field;
 *   uint64_t first_8_bytes;
 *   uint64_t bytes_8_16;
 *   uint64_t bytes_16_24;
 *   uint64_t bytes_24_32;
 * } */
TRACE_EVENT(TASK_MEM_SNAPSHOT, 1, TRACE_CAT_SYSCALL, 80)

/* Bulk write detection (memset, memcpy, struct assignment) - payload: struct {
 *   uint64_t target_ptr;
 *   uint64_t source_ptr;   // for memcpy, 0 for memset
 *   uint32_t size;
 *   uint8_t  operation;    // 0=memset, 1=memcpy, 2=struct_assign
 *   uint64_t host_thread_id;
 * } */
TRACE_EVENT(TASK_BULK_WRITE, 1, TRACE_CAT_SYSCALL, 32)

/* Canary value written/read - payload: struct {
 *   uint64_t task_ptr;
 *   uint64_t canary_value;
 *   uint8_t  operation;    // 0=write, 1=read
 *   uint64_t host_thread_id;
 * } */
TRACE_EVENT(TASK_CANARY, 1, TRACE_CAT_SYSCALL, 24)

/* ============================================
 * Exec Path Investigation Events (NULL pointer crash)
 * ============================================ */

/* MM operation boundary in exec - payload: struct {
 *   uint64_t current_ptr;
 *   uint32_t pid;
 *   uint64_t mm;
 *   uint64_t mem;
 *   uint64_t old_mm;       // valid before mm_release, 0 after
 *   uint64_t new_mm;       // valid around task_set_mm
 *   uint8_t  operation;    // 0=before_mm_release, 1=after_mm_release, 2=before_task_set_mm, 3=after_task_set_mm
 *   int      err;          // error code if applicable
 * } */
TRACE_EVENT(EXEC_MM_BOUNDARY, 1, TRACE_CAT_SYSCALL, 48)

/* Exec path entry/exit - payload: struct {
 *   uint64_t current_ptr;
 *   uint32_t pid;
 *   uint64_t mm;
 *   uint64_t mem;
 *   uint8_t  point;        // 0=do_execve_entry, 1=__do_execve_entry, 2=before_format_exec, 3=after_format_exec, 4=elf_exec_entry, 5=before_elf_exec_return, 6=after_do_execve_return
 *   int      err;          // error code if applicable
 * } */
TRACE_EVENT(EXEC_PATH_BOUNDARY, 1, TRACE_CAT_SYSCALL, 32)

#undef TRACE_EVENT
