{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--enable-web-dashboard",
        "false",
        "--project",
        "."
      ],
      "enabled": true,
      "environment": {}
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "rulesync": {
      "type": "local",
      "command": [
        "rulesync",
        "mcp"
      ],
      "enabled": true,
      "environment": {}
    }
  },
  "lsp": {
    "asm-lsp": {
      "command": ["asm-lsp"],
      "extensions": [".s", ".S", ".asm"],
      "initialization": {
        "assembler": "gas",
        "instruction_set": "arm64"
      }
    },
    "clangd": {
      "command": ["/usr/bin/clangd"],
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".h", ".hpp"]
    }
  }
}
