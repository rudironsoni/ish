{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "serena": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--enable-web-dashboard",
        "false",
        "--project",
        "."
      ],
      "enabled": true,
      "environment": {}
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "XcodeBuildMCP": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@rudironsoni/xcodebuildmcp@latest"
      ],
      "enabled": true,
      "environment": {}
    },
    "rulesync": {
      "type": "local",
      "command": [
        "pnpm",
        "dev",
        "mcp"
      ],
      "enabled": true,
      "environment": {}
    }
  }
}
